<% entry = user_entry.entry %>
<article id="<%= dom_id(user_entry) %>" class="entry<%= " is-read" if user_entry.read? %>">
  <%= link_to entry_path(entry), class: "entry__main", data: { turbo_frame: "_top", turbo_prefetch: false } do %>
    <div class="entry__body">
      <div class="entry__meta">
        <%= source_avatar(entry.source, title: user_entry.subscription.title, css_class: "avatar avatar--xs") %>
        <span class="entry__source"><%= user_entry.subscription.title %></span>
        <span aria-hidden="true">·</span>
        <%= time_ago(entry.published_at) %>
      </div>
      <h3 class="entry__title"><%= entry.title %></h3>
      <% if entry.summary.present? %>
        <p class="entry__summary"><%= entry.summary.truncate(180) %></p>
      <% end %>
    </div>
    <% if entry.thumbnail_url %>
      <%= image_tag entry.thumbnail_url, alt: "", class: "entry__thumb", loading: "lazy", referrerpolicy: "no-referrer" %>
    <% end %>
  <% end %>

  <div class="entry__actions">
    <%= render "entries/star_button", user_entry: user_entry %>
    <%= render "entries/read_button", user_entry: user_entry %>
  </div>
</article>
