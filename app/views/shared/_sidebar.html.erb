<nav id="sidebar" class="nav" data-controller="nav sortable collapse" aria-label="Reading"
     data-action="pointerdown->sortable#press dragstart->sortable#preventNativeDrag">
  <div class="nav__section">
    <%= nav_link "Today", entries_path(view: "today"), count: sidebar.today_count %>
    <%= nav_link "All unread", entries_path(view: "unread"), count: sidebar.unread_count %>
    <%= nav_link "Starred", entries_path(view: "starred"), count: sidebar.starred_count %>
  </div>

  <% sidebar.sections.each do |group, subscriptions| %>
    <%# "Other" stays in the page when empty so sources can be dragged out of their group. %>
    <% collapsed = group ? group.collapsed? : Current.user.ungrouped_collapsed? %>
    <%= tag.div class: [ "nav__section", ("nav__section--placeholder" if group.nil? && subscriptions.empty?), ("is-collapsed" if collapsed) ],
          data: ({ sortable_group: true, url: group_position_path(group) } if group) do %>
      <% if group %>
        <%= tag.button type: "button", class: "nav-link nav-link--group",
              aria: { expanded: !collapsed, controls: dom_id(group, :sources) },
              data: { action: "collapse#toggle", url: group_collapse_path(group), sortable_handle: true } do %>
          <span class="nav-link__label"><%= group.name %></span>
          <% if (count = sidebar.unread_count_for_group(subscriptions)).positive? %>
            <span class="count"><%= count %></span>
          <% end %>
        <% end %>
      <% else %>
        <%= tag.button type: "button", class: "nav__heading",
              aria: { expanded: !collapsed, controls: "ungrouped_sources" },
              data: { action: "collapse#toggle", url: ungrouped_collapse_path } do %>
          <span class="nav-link__label">Other</span>
          <% if (count = sidebar.unread_count_for_group(subscriptions)).positive? %>
            <span class="count"><%= count %></span>
          <% end %>
        <% end %>
      <% end %>

      <%= tag.div id: (group ? dom_id(group, :sources) : "ungrouped_sources"), class: "nav__sources", data: { sortable_sources: true, group_id: group&.id.to_s } do %>
        <% subscriptions.each do |subscription| %>
          <%= link_to entries_path(subscription_id: subscription.id), class: [ "nav-link", "nav-link--source", ("is-muted" if subscription.muted?) ],
                data: { sortable_source: true, sortable_handle: true, url: subscription_position_path(subscription) } do %>
            <%= source_avatar(subscription.source, title: subscription.title, css_class: "avatar avatar--sm") %>
            <span class="nav-link__label"><%= subscription.title %></span>
            <% if subscription.source.failing? %>
              <span class="badge badge--warn" title="<%= subscription.source.last_error %>">!</span>
            <% end %>
            <% if (count = sidebar.unread_count_for(subscription)).positive? %>
              <span class="count"><%= count %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if sidebar.empty? %>
    <p class="nav__empty">No sources yet. <%= link_to "Add your first one", new_subscription_path %>.</p>
  <% end %>

  <div class="nav__footer">
    <%= link_to "Manage sources", subscriptions_path %>
    <%= link_to "Account", settings_path %>
    <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
  </div>
</nav>
