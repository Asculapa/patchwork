<% content_for :title, "New password" %>

<h1 class="auth__title">Choose a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <div class="field">
    <%= form.label :password, "New password", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Repeat new password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>
  <%= form.submit "Save", class: "button button--primary button--block" %>
<% end %>
