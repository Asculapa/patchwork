<% content_for :title, "Reset password" %>

<h1 class="auth__title">Forgot your password?</h1>

<%= form_with url: passwords_path, class: "form" do |form| %>
  <div class="field">
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <%= form.submit "Email reset instructions", class: "button button--primary button--block" %>
<% end %>

<p class="auth__alt"><%= link_to "Back to sign in", new_session_path %></p>
