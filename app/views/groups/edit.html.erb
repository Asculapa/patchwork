<% content_for :title, "Rename #{@group.name_was}" %>

<header class="page-header">
  <h1 class="page-title">Rename group</h1>
</header>

<%= render "shared/account_tabs" %>

<%= form_with model: @group, class: "card form" do |form| %>
  <% if @group.errors.any? %>
    <div class="notice notice--alert"><%= @group.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="field">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input", required: true, maxlength: 50, autofocus: true %>
  </div>
  <div class="form__actions">
    <%= form.submit "Save", class: "button button--primary" %>
    <%= link_to "Cancel", groups_path, class: "button button--ghost" %>
  </div>
<% end %>
