<% content_for :title, "Settings" %>

<header class="page-header">
  <div class="page-header__text">
    <h1 class="page-title">Settings</h1>
    <p class="page-subtitle">Signed in as <%= @user.email_address %></p>
  </div>
</header>

<%= render "shared/account_tabs" %>

<%= form_with model: @user, url: settings_path, method: :patch, class: "card form" do |form| %>
  <% if @user.errors.any? %>
    <div class="notice notice--alert"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="field">
    <%= form.label :time_zone, class: "label" %>
    <%= form.select :time_zone, time_zone_options(@user.time_zone), {}, class: "input" %>
    <p class="hint">Used for dates and times across Patchwork.</p>
  </div>
  <div class="form__actions">
    <%= form.submit "Save", class: "button button--primary" %>
  </div>
<% end %>

<div class="card form" data-controller="push-notifications">
  <div class="field">
    <span class="label">Notifications</span>
    <p class="hint" data-push-notifications-target="unsupported" hidden>
      This browser doesn't support push notifications.
    </p>
    <p class="hint">
      Get a reminder at 9am and 9pm (your time) when you have unread articles. This is per
      device &mdash; enable it on each browser or phone you want notified.
    </p>
  </div>
  <div class="form__actions">
    <button type="button" class="button button--primary" data-push-notifications-target="enableButton"
      data-action="push-notifications#enable" hidden>Enable notifications on this device</button>
    <button type="button" class="button" data-push-notifications-target="disableButton"
      data-action="push-notifications#disable" hidden>Disable notifications on this device</button>
  </div>
</div>
