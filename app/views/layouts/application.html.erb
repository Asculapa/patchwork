<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="app" data-controller="sidebar" data-sidebar-open-class="sidebar-open">
    <header class="topbar">
      <button type="button" class="icon-button topbar__menu" data-action="sidebar#toggle" aria-label="Toggle navigation">☰</button>
      <%= link_to root_path, class: "brand" do %>
        <span class="brand__mark" aria-hidden="true"></span>Patchwork
      <% end %>
      <%= link_to "Add source", new_subscription_path, class: "button button--primary topbar__add" %>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <%= render "shared/sidebar" %>
      </aside>

      <main class="main">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
