<% content_for :title, "Create account" %>

<h1 class="auth__title">Create your account</h1>

<%= form_with model: @user, url: registration_path, class: "form", data: { controller: "timezone" } do |form| %>
  <% if @user.errors.any? %>
    <div class="notice notice--alert"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= form.hidden_field :time_zone, data: { timezone_target: "field" } %>

  <div class="field">
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "input" %>
  </div>
  <div class="field">
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
    <p class="hint">At least 8 characters.</p>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Repeat password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>
  <%= form.submit "Create account", class: "button button--primary button--block" %>
<% end %>

<p class="auth__alt">Already have an account? <%= link_to "Sign in", new_session_path %></p>
